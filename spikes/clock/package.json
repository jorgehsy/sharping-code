{
  "name": "clock-spike",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build:lambda": "esbuild src/handler.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.mjs --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "synth": "npm run build:lambda && cdk synth",
    "start:game": "tsx scripts/start.ts",
    "subscribe": "tsx scripts/subscribe.ts"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-lambda": "^3.1149.0",
    "@aws-sdk/credential-provider-node": "^3.972.85",
    "@aws/durable-execution-sdk-js": "^2.6.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4"
  },
  "devDependencies": {
    "@aws/durable-execution-sdk-js-testing": "^1.3.0",
    "@types/node": "^26.6.5",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
